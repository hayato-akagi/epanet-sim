{
  "control_mode": "flow",
  "network": {
    "inp_file": "Net1_flow.inp"
  },
  "simulation": {
    "duration": 86400,
    "hydraulic_step": 600
  },
  "control_loops": [
    {
      "loop_id": "loop_1",
      "target": {
        "node_id": "2",
        "target_pressure": 30.0,
        "target_flow": 1200.0,
        "target_flow_profile": [
          {"time": 0, "value": 1200.0},
          {"time": 21600, "value": 1700.0},
          {"time": 43200, "value": 900.0},
          {"time": 64800, "value": 1500.0}
        ]
      },
      "actuator": {
        "link_id": "10",
        "initial_setting": 0.5,
        "min_setting": 0.1,
        "max_setting": 1.0
      },
      "vla_params": {
        "model_type": "simple_dnn",
        "checkpoint_path": null,
        "learning_mode": "online",
        "algorithm": "sac",
        "device": "cpu",
        "network": {
          "hidden_dims": [256, 256],
          "activation": "relu"
        },
        "training": {
          "buffer_size": 10000,
          "batch_size": 32,
          "learning_rate_actor": 0.0003,
          "learning_rate_critic": 0.0003,
          "learning_rate_alpha": 0.0003,
          "gamma": 0.99,
          "tau": 0.005,
          "alpha": 0.15,
          "learning_starts": 100,
          "update_frequency": 1,
          "gradient_steps": 1
        },
        "exploration": {
          "initial_random_steps": 40
        },
        "observation": {
          "use_images": true,
          "image_types": ["system_ui", "valve_detail", "flow_dashboard", "comparison"],
          "use_numerical": true
        },
        "action": {
          "type": "continuous",
          "delta_range": [-0.06, 0.06],
          "absolute_range": [0.1, 1.0],
          "clip": true
        },
        "reward": {
          "tracking_weight": 2.0,
          "stability_weight": 0.7,
          "safety_weight": 1.0,
          "normalize": true,
          "clip_range": [-20, 20],
          "safety_bounds": {
            "pressure_min": 45.0,
            "pressure_max": 65.0
          }
        },
        "checkpointing": {
          "save_frequency": 50,
          "save_dir": "/shared/checkpoints"
        }
      }
    }
  ],
  "experiment": {
    "name": "net1_flow_vla_profile_tuned",
    "description": "VLA with time-varying flow target profile (step changes)",
    "max_episodes": 20,
    "seed": 42
  }
}
